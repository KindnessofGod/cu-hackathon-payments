# Copy to .env and fill in. Never commit .env or private keys.

# Set to 1 to run against a clearly labelled SIMULATED wallet (no Open Payments calls, no keys needed).
MOCK_OP=1

# --- Real test wallet (set MOCK_OP=0 and fill these in) ---

# Seller app (shop / POS agent)
RECEIVER_WALLET_ADDRESS_URL=https://ilp.interledger-test.dev/your-seller
RECEIVER_KEY_ID=
# The downloaded private.key: paste its text, or base64 of the file, or a path to it.
RECEIVER_PRIVATE_KEY=

# Customer app
PAYER_WALLET_ADDRESS_URL=https://ilp.interledger-test.dev/your-customer
PAYER_KEY_ID=
PAYER_PRIVATE_KEY=

# At least 32 random characters. Encrypts stored grant tokens and signs approvals.
APP_SECRET=

# Public HTTPS address of the deployed app, used for the wallet's redirect back to us.
# Leave empty for local runs (http://localhost:3000 is used).
PUBLIC_BASE_URL=

# Storage. Empty = a local JSON file in .data/. Set a Postgres connection string for the deployed app.
DATABASE_URL=

# Seconds a payment request stays open (default 180).
REQUEST_TTL_SECONDS=

# Planned (voice), server side only. Not used yet.
SPITCH_API_KEY=
ELEVENLABS_API_KEY=

# --- Judge demo (/demo) ---
# Phone alert when a judge asks for access: install the free ntfy app and subscribe to this exact topic.
# Use a long random topic name; anyone who knows it can read the alerts.
NTFY_TOPIC=
# Optional email alert (Brevo). All three needed.
BREVO_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# Caps for approved judges (defaults shown). Live conversations are each at most 10 minutes.
# JUDGE_HOURS=24
# JUDGE_AGENT_SESSIONS=3
# JUDGE_GLOBAL_AGENT_PER_DAY=30
# Set to 1 to lock voice for EVERY customer too (default: only simulated demo customers are locked).
# VOICE_GATE_ALL=
