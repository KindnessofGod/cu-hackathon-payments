# Copy to .env and fill in. Never commit .env or private keys.

# Receiver app (shop / POS agent)
RECEIVER_WALLET_ADDRESS_URL=https://ilp.interledger-test.dev/your-receiver
RECEIVER_KEY_ID=
RECEIVER_PRIVATE_KEY=   # base64 or PEM, per the SDK docs

# Payer app (customer)
PAYER_WALLET_ADDRESS_URL=https://ilp.interledger-test.dev/your-payer
PAYER_KEY_ID=
PAYER_PRIVATE_KEY=

# Public HTTPS base URL used for the wallet's redirect callback
PUBLIC_BASE_URL=https://your-app.vercel.app

# Set to 1 to run against a clearly labelled mock Open Payments server (SIMULATED)
MOCK_OP=0

# Storage
DATABASE_URL=

# Later (voice) - server side only
SPITCH_API_KEY=
ELEVENLABS_API_KEY=
